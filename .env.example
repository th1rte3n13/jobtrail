# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public: safe to expose to the browser (protected by Row-Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never prefix with NEXT_PUBLIC_ or import into client components
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
